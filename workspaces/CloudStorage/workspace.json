{
  "description": "Utilizes rclone, a command-line program to manage files on cloud storage",
  "docker_registry": "https://index.docker.io/v1/",
  "image_src": "rclone.png",
  "friendly_name": "Cloud Storage",
  "cores": 2,
  "memory": 4096,
  "gpu_count": 0,
  "cpu_allocation_method": "Inherit",
  "run_config": {
    "hostname": "kasm-rclone",
    "privileged": true
  },
  "exec_config": {
    "first_launch": {
      "user": "root",
      "cmd": "bash -c 'echo \"kasm-user  ALL=(ALL) NOPASSWD: ALL\" >> /etc/sudoers'"
    }
  },
  "categories": [
    "Productivity",
    "Desktop"
  ],
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.18.x",
      "image": "doctorwhen/kasm:1.16.0-rolling-daily",
      "uncompressed_size_mb": 12300,
      "available_tags": [
        "develop",
        "1.16.0",
        "1.16.0-rolling-weekly",
        "1.16.0-rolling-daily"
      ]
    }
  ]
}